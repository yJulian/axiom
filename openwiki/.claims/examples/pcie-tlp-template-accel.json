  "claims": [
    {
      "id": "claim_baaa44747ba14fe4a8ede00076ae5bc6",
      "statement": "pcie_tlp_template_accel.sv is functionally the same register/DMA/interrupt device as pcie_template_accel.sv, differing only in VERSION (0x00020000 vs the AXI4 variant) and in receiving raw PCIe TLPs on a completer-request stream (parsing fmt/type/length/requester-ID/tag/byte-enables/address itself) instead of an AXI4 slave port.",
      "evidence": [
        {
          "resource": "repo://examples/pcie_tlp_template_accel/pcie_tlp_template_accel.sv#L1-L33",
          "version": "repo-lines-v1:sha256:119059feb32a329fcf0656bf3cd412c4a50109051934b9b63f0b1d4faf5825bd:"
        }
      ]
    },
    {
      "id": "claim_f5e0d59b90954ccdb8c9a1bb91007979",
      "statement": "pcie_tlp_template_accel.sv keeps its registers on an 8-byte stride for a TLP-specific reason: a TLP carries payload as DWs with per-DW byte enables, so beat alignment lets a 64-bit access be one beat and a 32-bit access be the low DW of one beat with no DW-level shifting.",
      "evidence": [
        {
          "resource": "repo://examples/pcie_tlp_template_accel/pcie_tlp_template_accel.sv#L35-L39",
          "version": "repo-lines-v1:sha256:19917a7bc33635e42a6b30b1fccd3dc855c269ac7b83089c586644ccb77e35e7:"
        }
      ]
    },
    {
      "id": "claim_4d4c0cef1e1846b8ac1a603ad2f5a1d9",
      "statement": "PcieTlpTemplateAccel.py sets DeviceID=0x0002 (distinct from PcieTemplateAccel's 0x0001, so a guest can distinguish the two) and completer_id=0x0008 matching the DUT's hardcoded COMPLETER_ID, while keeping VendorID, ClassCode, BAR0, and InterruptLine/InterruptPin the same as the AXI4 variant, and likewise defines no generateDeviceTree().",
      "evidence": [
        {
          "resource": "repo://examples/pcie_tlp_template_accel/PcieTlpTemplateAccel.py#L1-L48",
          "version": "repo-lines-v1:sha256:227959cc21a35c24409e429f6a26e18ccb818c198fbab423bf4fe8aa7550b628:"
        }
      ]
    },
    {
      "id": "claim_a7e7093369b04504b5fb01beebf3fa42",
      "statement": "PcieTlpTemplateAccel implements PcieTlpCompleterPins, PcieTlpRequesterPins, and the two sideband hooks (rtlGetIrq, isIdle) directly against Vpcie_tlp_template_top with no dlopen indirection, using 16 pin accessors total versus the AXI4 examples' 88.",
