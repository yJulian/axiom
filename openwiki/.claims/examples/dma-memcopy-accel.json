    {
      "id": "claim_8ca431c829e74501bc83c44bf42e30be",
      "statement": "dma_memcopy.sv's per-channel control/status register map uses a 0x20-byte stride with SRC at +0x00, DST at +0x08, CTRL (write bit0=1 to start) at +0x10, and STATUS (bit0=busy, bit1=done, reading clears done) at +0x18.",
      "evidence": [
