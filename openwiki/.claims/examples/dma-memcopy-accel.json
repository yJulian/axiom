          "resource": "repo://examples/dma_memcopy_accel/dma_memcopy.sv#L21-L26",
          "version": "repo-lines-v1:sha256:823a8495605508bc2ff4d4c36055276cd738fce071014181f3aa3f3a22e91dcc:"
        }
