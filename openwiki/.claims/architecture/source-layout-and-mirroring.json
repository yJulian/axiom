    {
      "id": "claim_20db95ae6a274745916f03a27cc2e86f",
      "statement": "scripts/build_gem5.sh mirrors src/{axi,pcie,cpu/rtl,dev/rtl} and examples/ into ext/gem5/src using cp -rs (real directories with individual files symlinked back to this repo) rather than a plain symlinked directory, because gem5's src/SConscript walks with followlinks=False and would not see a symlinked directory at all.",
      "evidence": [
        {
          "resource": "repo://scripts/build_gem5.sh#L1-L24",
          "version": "repo-lines-v1:sha256:f5c64548147333cfed708a09b906832429d638fb9bf75148de98804377f8364c:"
        },
