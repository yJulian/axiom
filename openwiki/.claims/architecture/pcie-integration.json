    {
      "id": "claim_a6bb0c27a0fb4cda96b0850b5911e6ef",
      "statement": "RTLPciDevice's RtlPioPort answers config-space accesses synchronously out of PciDevice's own header state without involving the RTL, but panics on atomic/functional BAR accesses since those require running the RTL clock via the timing-only tick loop.",
